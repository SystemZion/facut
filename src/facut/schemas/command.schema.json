{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facut.dev/schemas/command.schema.json",
  "title": "facut atomic command batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "atomic": {
      "type": "boolean",
      "default": true
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  }
}
