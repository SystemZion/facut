{
  "$defs": {
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_id": {
          "title": "Media Id",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "timeline_start": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Timeline Start",
          "type": "number"
        },
        "source_in": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Source In",
          "type": "number"
        },
        "source_out": {
          "exclusiveMinimum": 0.0,
          "title": "Source Out",
          "type": "number"
        },
        "speed": {
          "default": 1.0,
          "ne": 0.0,
          "title": "Speed",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "media_id",
        "track_id",
        "source_out"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "command": {
          "additionalProperties": true,
          "title": "Command",
          "type": "object"
        }
      },
      "required": [
        "revision",
        "action",
        "summary"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "property": {
          "title": "Property",
          "type": "string"
        },
        "time": {
          "minimum": 0.0,
          "title": "Time",
          "type": "number"
        },
        "value": {
          "title": "Value"
        },
        "easing": {
          "default": "linear",
          "title": "Easing",
          "type": "string"
        }
      },
      "required": [
        "property",
        "time",
        "value"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "at": {
          "minimum": 0.0,
          "title": "At",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "color": {
          "default": "#FFD54F",
          "title": "Color",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "at"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MediaAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "original_name": {
          "title": "Original Name",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "technical": {
          "$ref": "#/$defs/MediaTechnicalInfo"
        },
        "proxy_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Path"
        },
        "offline": {
          "default": false,
          "title": "Offline",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "original_name",
        "size",
        "sha256"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video",
        "audio",
        "image",
        "subtitle"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "MediaTechnicalInfo": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "bitrate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate"
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Codec"
        },
        "audio_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Codec"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Rate"
        },
        "average_frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Frame Rate"
        },
        "pixel_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "color_transfer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Transfer"
        },
        "color_primaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Primaries"
        },
        "audio_channels": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Channels"
        },
        "sample_rate": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "has_subtitles": {
          "default": false,
          "title": "Has Subtitles",
          "type": "boolean"
        },
        "variable_frame_rate": {
          "default": false,
          "title": "Variable Frame Rate",
          "type": "boolean"
        },
        "creation_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creation Time"
        },
        "keyframes": {
          "items": {
            "type": "number"
          },
          "title": "Keyframes",
          "type": "array"
        }
      },
      "title": "MediaTechnicalInfo",
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 1920,
          "maximum": 16384,
          "minimum": 16,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "maximum": 16384,
          "minimum": 16,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "maximum": 240.0,
          "title": "Fps",
          "type": "number"
        },
        "sample_rate": {
          "default": 48000,
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "background": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Background",
          "type": "string"
        },
        "duration": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProjectSettings",
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TrackType"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "order": {
          "default": 0,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "title": "Clips",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "Track",
      "type": "object"
    },
    "TrackType": {
      "enum": [
        "video",
        "audio",
        "image",
        "subtitle",
        "adjustment",
        "mask"
      ],
      "title": "TrackType",
      "type": "string"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "scale_x": {
          "default": 1.0,
          "title": "Scale X",
          "type": "number"
        },
        "scale_y": {
          "default": 1.0,
          "title": "Scale Y",
          "type": "number"
        },
        "rotation": {
          "default": 0.0,
          "title": "Rotation",
          "type": "number"
        },
        "anchor_x": {
          "default": 0.5,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 0.5,
          "title": "Anchor Y",
          "type": "number"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "crop_left": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Crop Left",
          "type": "number"
        },
        "crop_top": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Crop Top",
          "type": "number"
        },
        "crop_right": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Crop Right",
          "type": "number"
        },
        "crop_bottom": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Crop Bottom",
          "type": "number"
        },
        "fit": {
          "default": "contain",
          "enum": [
            "contain",
            "cover",
            "stretch",
            "none"
          ],
          "title": "Fit",
          "type": "string"
        },
        "flip_x": {
          "default": false,
          "title": "Flip X",
          "type": "boolean"
        },
        "flip_y": {
          "default": false,
          "title": "Flip Y",
          "type": "boolean"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "duration": {
          "exclusiveMinimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "from_clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Clip Id"
        },
        "to_clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Clip Id"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "at": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "sound_media_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sound Media Id"
        },
        "sound_offset": {
          "default": 0.0,
          "title": "Sound Offset",
          "type": "number"
        }
      },
      "required": [
        "type",
        "duration"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/ProjectSettings"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/MediaAsset"
      },
      "title": "Media",
      "type": "array"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/Track"
      },
      "title": "Tracks",
      "type": "array"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "title": "Transitions",
      "type": "array"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/Marker"
      },
      "title": "Markers",
      "type": "array"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "project"
  ],
  "title": "ProjectDocument",
  "type": "object"
}
