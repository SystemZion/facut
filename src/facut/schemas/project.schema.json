      "title": "MediaTechnicalInfo",
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 1920,
          "maximum": 16384,
          "minimum": 16,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "maximum": 16384,
          "minimum": 16,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "maximum": 240.0,
          "title": "Fps",
          "type": "number"
        },
        "sample_rate": {
          "default": 48000,
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "background": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Background",
          "type": "string"
        },
        "duration": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProjectSettings",
      "type": "object"
    },
    "SubtitleCue": {
      "additionalProperties": false,
      "description": "One timed subtitle cue attached to a subtitle track.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identifier"
        },
        "settings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Settings",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "track_id",
        "start",
        "end",
        "text"
      ],
      "title": "SubtitleCue",
      "type": "object"
    },
    "TextOverlay": {
      "additionalProperties": false,
      "description": "Timed free text rendered independently of spoken-word subtitles.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
