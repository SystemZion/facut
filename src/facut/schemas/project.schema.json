{
  "$defs": {
    "AudioCompressorSettings": {
      "additionalProperties": false,
      "description": "Non-destructive dynamic-range compressor parameters.",
      "properties": {
        "threshold_db": {
          "default": -18.0,
          "maximum": 0.0,
          "minimum": -60.0,
          "title": "Threshold Db",
          "type": "number"
        },
        "ratio": {
          "default": 4.0,
          "maximum": 20.0,
          "minimum": 1.0,
          "title": "Ratio",
          "type": "number"
        },
        "attack_ms": {
          "default": 20.0,
          "maximum": 2000.0,
          "minimum": 0.01,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 250.0,
          "maximum": 9000.0,
          "minimum": 1.0,
          "title": "Release Ms",
          "type": "number"
        },
        "makeup_db": {
          "default": 0.0,
          "maximum": 24.0,
          "minimum": 0.0,
          "title": "Makeup Db",
          "type": "number"
        }
      },
      "title": "AudioCompressorSettings",
      "type": "object"
    },
    "AudioLimiterSettings": {
      "additionalProperties": false,
      "description": "True peak guard compiled to FFmpeg's alimiter filter.",
      "properties": {
        "ceiling_db": {
          "default": -1.0,
          "maximum": 0.0,
          "minimum": -20.0,
          "title": "Ceiling Db",
          "type": "number"
        },
        "attack_ms": {
          "default": 5.0,
          "maximum": 80.0,
          "minimum": 0.1,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 50.0,
          "maximum": 8000.0,
          "minimum": 1.0,
          "title": "Release Ms",
          "type": "number"
        }
      },
      "title": "AudioLimiterSettings",
      "type": "object"
    },
    "AudioLoudnessSettings": {
      "additionalProperties": false,
      "description": "Single-pass EBU R128 loudness normalization targets.",
      "properties": {
        "target_lufs": {
          "default": -14.0,
          "maximum": -5.0,
          "minimum": -70.0,
          "title": "Target Lufs",
          "type": "number"
        },
        "true_peak_db": {
          "default": -1.0,
          "maximum": 0.0,
          "minimum": -9.0,
          "title": "True Peak Db",
          "type": "number"
        },
        "loudness_range": {
          "default": 11.0,
          "maximum": 50.0,
          "minimum": 1.0,
          "title": "Loudness Range",
          "type": "number"
        }
      },
      "title": "AudioLoudnessSettings",
      "type": "object"
    },
    "AudioProcessing": {
      "additionalProperties": false,
      "description": "Unified audio settings shared by native and independent audio clips.",
      "properties": {
        "gain_db": {
          "default": 0.0,
          "maximum": 24.0,
          "minimum": -96.0,
          "title": "Gain Db",
          "type": "number"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "fade_in": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Fade In",
          "type": "number"
        },
        "fade_out": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Fade Out",
          "type": "number"
        },
        "highpass_hz": {
          "anyOf": [
            {
              "maximum": 20000.0,
              "minimum": 20.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highpass Hz"
        },
        "denoise_strength": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.01,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denoise Strength"
        },
        "compressor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioCompressorSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limiter": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioLimiterSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioLoudnessSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "channel_mode": {
          "default": "original",
          "enum": [
            "original",
            "mono",
            "stereo"
          ],
          "title": "Channel Mode",
          "type": "string"
        },
        "pan": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pan"
        }
      },
      "title": "AudioProcessing",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_id": {
          "title": "Media Id",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "timeline_start": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Timeline Start",
          "type": "number"
        },
        "source_in": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Source In",
          "type": "number"
        },
        "source_out": {
          "exclusiveMinimum": 0.0,
          "title": "Source Out",
          "type": "number"
        },
        "speed": {
          "default": 1.0,
          "title": "Speed",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        },
        "timeline_duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeline Duration"
        },
        "freeze_frame": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freeze Frame"
        },
        "loop": {
          "default": false,
          "title": "Loop",
          "type": "boolean"
        },
        "audio_fade_in": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Audio Fade In",
          "type": "number"
        },
        "audio_fade_out": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Audio Fade Out",
          "type": "number"
        },
        "audio": {
          "$ref": "#/$defs/AudioProcessing"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "media_id",
        "track_id",
        "source_out"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "command": {
          "additionalProperties": true,
          "title": "Command",
          "type": "object"
        },
        "commit_id": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ],
          "default": null,
          "title": "Commit Id"
        },
        "parent_commit_ids": {
          "items": {"type": "string"},
          "title": "Parent Commit Ids",
          "type": "array"
        },
        "branch": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ],
          "default": null,
          "title": "Branch"
        },
        "actor": {
          "default": "user",
          "enum": ["user", "agent", "system"],
          "title": "Actor",
          "type": "string"
        },
        "intent": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ],
          "default": null,
          "title": "Intent"
        }
      },
      "required": [
        "revision",
        "action",
        "summary"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "property": {
          "title": "Property",
          "type": "string"
        },
        "time": {
          "minimum": 0.0,
          "title": "Time",
          "type": "number"
        },
        "value": {
          "title": "Value"
        },
        "easing": {
          "default": "linear",
          "title": "Easing",
          "type": "string"
        }
      },
      "required": [
        "property",
        "time",
        "value"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "at": {
          "minimum": 0.0,
          "title": "At",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "color": {
          "default": "#FFD54F",
          "title": "Color",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "at"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MediaAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "original_name": {
          "title": "Original Name",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "technical": {
          "$ref": "#/$defs/MediaTechnicalInfo"
        },
        "proxy_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Path"
        },
        "offline": {
          "default": false,
          "title": "Offline",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "original_name",
        "size",
        "sha256"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video",
        "audio",
        "image",
        "subtitle"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "MediaTechnicalInfo": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "bitrate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate"
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Codec"
        },
        "audio_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Codec"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Rate"
        },
        "average_frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Frame Rate"
        },
        "pixel_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "color_transfer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Transfer"
        },
        "color_primaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Primaries"
        },
        "audio_channels": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Channels"
        },
        "sample_rate": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "has_subtitles": {
          "default": false,
          "title": "Has Subtitles",
          "type": "boolean"
        },
        "variable_frame_rate": {
          "default": false,
          "title": "Variable Frame Rate",
          "type": "boolean"
        },
        "creation_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creation Time"
        },
        "timecode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timecode"
        },
        "timezone_offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Offset"
        },
        "camera_make": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Make"
        },
        "camera_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Model"
        },
        "lens_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lens Model"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "altitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude"
        },
        "dynamic_range": {
          "default": "unknown",
          "enum": [
            "sdr",
            "hdr-pq",
            "hdr-hlg",
            "log",
